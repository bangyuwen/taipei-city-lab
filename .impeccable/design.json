      "css": ".ds-outline{font-family:\"Noto Sans TC\",\"PingFang TC\",\"Microsoft JhengHei\",sans-serif;font-size:13px;min-height:44px;padding:10px 14px;border-radius:8px;line-height:1.6;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer}.ds-outline:focus-visible{outline:3px solid var(--focus,#a23d27);outline-offset:4px}.ds-outline:disabled{cursor:not-allowed;opacity:.55}.ds-outline{border:1px solid #aab1bf;background:transparent;color:var(--ink,#202c45)}.ds-outline:hover{background:#e8e6df;border-color:#8893a6}"
