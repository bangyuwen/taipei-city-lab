      "css": ".ds-primary{font-family:\"Noto Sans TC\",\"PingFang TC\",\"Microsoft JhengHei\",sans-serif;font-size:13px;min-height:44px;padding:10px 14px;border-radius:8px;line-height:1.6;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer}.ds-primary:focus-visible{outline:3px solid var(--focus,#a23d27);outline-offset:4px}.ds-primary:disabled{cursor:not-allowed;opacity:.55}.ds-primary{border:1px solid transparent;background:var(--signal,#ae432c);color:#fff;font-weight:600}.ds-primary:hover{background:#a63e28}.ds-primary:active{background:#893322}"
