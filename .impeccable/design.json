      "css": ".ds-select{font-family:\"Noto Sans TC\",\"PingFang TC\",\"Microsoft JhengHei\",sans-serif;width:100%;padding:10px 8px;border:1px solid #d7ded1;border-radius:3px;background:var(--panel,#fffefa);color:var(--ink,#213b33);font-size:14px;min-height:44px}.ds-select:focus-visible{outline:3px solid #d5a450;outline-offset:4px}"
    },
