      "css": ".ds-outline{font-family:\"Noto Sans TC\",\"PingFang TC\",\"Microsoft JhengHei\",sans-serif;font-size:13px;line-height:1.5;min-height:44px;padding:10px 14px;border-radius:3px;cursor:pointer;color:var(--ink,#213b33);background:transparent;border:1px solid #cdd7cb}.ds-outline:hover{background:#e9ede3}.ds-outline:focus-visible{outline:3px solid #d5a450;outline-offset:4px}.ds-outline:disabled{cursor:not-allowed;opacity:.55}"
