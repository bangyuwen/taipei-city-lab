  "events": [
    {
      "id": "wanhua-qingcao-2025-07-11",
      "source": "wanhuaAugust",
      "page": 1,
      "date": "2025-07-11",
      "title": "官方記錄：西園路二段青草公園兩側，2025-07-11撤除",
      "account": "萬華區2025年8月29日區務會議記錄，環保局回覆西園路二段青草公園兩側清潔箱已在7月11日撤除。原案提到公車站清潔箱滿溢，要求加強巡收。",
      "limit": "文件證實行政機關記錄這項處置；沒有逐桶編號、座標或撤除後效果。原案稱和平青草園，回覆稱青草公園，名稱仍須核對。這批留言未提供可與此事件相接的同點與日期。"
    },
    {
      "id": "wanhua-police-2025-08-01",
      "source": "wanhuaAugust",
      "page": 1,
      "date": "2025-08-01",
      "title": "官方記錄：和平西路三段派出所旁，2025-08-01撤除",
      "account": "同份8月29日會議記錄的回覆另列和平西路三段派出所旁清潔箱，已於8月1日撤除；原案以康定派出所旁作為滿溢例子。",
      "limit": "兩個地點的處置日期不同，不能合成一次全區撤桶。會議列的10月31日是預定完成日欄，不是撤除日期；本研究沒有核實同一桶位或後續環境成效。"
    }
  ],
  "context": [
    {
      "source": "wanhuaJune",
      "label": "2025-06-30會議原件，第2頁",
      "text": "更早的6月30日會議已記錄康定派出所旁滿溢。清潔隊回覆加強巡收，並說明當時週三、週日沒有夜間巡收；主席要求繼續列管。這提供「先清運處理、後有撤除回覆」的行政脈絡，不能推為現在的班表，也不能證實撤除的完整決策原因。"
    },
    {
      "source": "policy",
      "label": "環保局2026-08-10說明",
      "text": "環保局公開說明將家戶混投、髒亂及地方需求納入移除評估；這是政策背景，不能自動當成每一則留言所指地點的撤除原因。"
    },
    {
      "source": "application",
      "label": "環保局清潔箱申請流程",
      "text": "公開申請流程可作後續查詢入口，但流程網頁沒有本輪各地的逐案撤移工單。仍需逐點取得處置日期、設施類型、負責機關、原因和替代投放安排。"
    }
  ],
  "examples": [],
  "nextSteps": [
    {
      "title": "補上可核對的地點與時間",
      "text": "優先把站名補到出口與道路側，把公園補到內外圍、入口與路線；回查留言日期，再核對前後照片、桶號及撤移工單。這是資料查核順序，不是缺桶程度排名。"
    },
    {
      "title": "同時看原點、替代點與垃圾去向",
      "text": "同一時段走過原路線，記錄距離、可見性、開放時間、桶滿程度及替代場所是否接受投放；分開觀察車籃、花圃與人行道垃圾，避免只移動問題。"
    },
    {
      "title": "依困難測試改善，保留管理條件",
      "text": "確認路線缺口後才評估恢復或重配；替代點滿溢則檢查容量、巡收和混投；設備難用則查開口與操作。每項都需觀察改善前後，尚未執行或證明有效。"
    }
